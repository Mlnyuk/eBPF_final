{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ebpf-final/schemas/triage_label.schema.json",
  "title": "TriageLabel",
  "description": "One label for a case bundle. Multiple labels may exist per event_id from different sources; src/triage/label_store.py resolves the final training label by source priority: operator_feedback > llm_adjudicator > fault_metadata > weak_rule.",
  "type": "object",
  "required": [
    "event_id", "label_source", "true_class", "recommended_action", "created_at"
  ],
  "additionalProperties": true,
  "properties": {
    "event_id": {"type": "string"},
    "label_source": {
      "type": "string",
      "enum": ["fault_metadata", "weak_rule", "llm_adjudicator", "operator_feedback"]
    },
    "true_class": {"type": "string", "enum": ["normal", "low", "medium", "high"]},
    "recommended_action": {"type": "string", "enum": ["suppress", "wait", "triage", "alert"]},
    "fault_type": {
      "type": "string",
      "enum": ["none", "syscall_spike", "tcp_retrans", "disk_io_latency",
               "cpu_pressure", "memory_pressure", "unknown"]
    },
    "confidence": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "reason": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"},
    "error": {"type": "string", "description": "Set on LLM fallback labels when JSON parsing failed."}
  }
}
