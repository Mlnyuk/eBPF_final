# LLM anomaly-triage image: kubectl + the triage script (stdlib only, no ML deps).
# Runs scripts/qwen_triage.py as a night-window CronJob (k8s/cronjob-triage.yaml):
# pull archive anomalies -> per-container baseline -> Qwen3-32B verdict -> Telegram.
FROM python:3.12-slim

# kubectl for exec-based archive reads (detector image has no tar -> no cp).
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl \
    && curl -sfL "https://dl.k8s.io/release/v1.30.5/bin/linux/amd64/kubectl" \
        -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY scripts/qwen_triage.py /usr/local/bin/qwen_triage.py
RUN chmod +x /usr/local/bin/qwen_triage.py

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["python3", "/usr/local/bin/qwen_triage.py"]
