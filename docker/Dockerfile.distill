# Distill-automation image: ML deps + kubectl + curl + the distill pipeline.
# Runs scripts/distill_pipeline.sh as a night CronJob (k8s/cronjob-distill.yaml):
# LLM-label the live anomaly stream -> distill a DecisionTree -> gate -> hot-swap
# the runtime noise filter into each detector pod's /noise-live + /reload.
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && curl -sfL "https://dl.k8s.io/release/v1.30.5/bin/linux/amd64/kubectl" \
        -o /usr/local/bin/kubectl \
    && chmod +x /usr/local/bin/kubectl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY configs/ ./configs/
COPY detector/ ./detector/
COPY scripts/qwen_distill_label.py ./scripts/qwen_distill_label.py
COPY scripts/distill_pipeline.sh /usr/local/bin/distill_pipeline.sh
RUN chmod +x /usr/local/bin/distill_pipeline.sh

ENV PYTHONUNBUFFERED=1
ENTRYPOINT ["/usr/local/bin/distill_pipeline.sh"]
